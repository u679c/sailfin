# make dev reads .env; shell environment wins. No variables are mandatory.
TRACELITE_ADDR=127.0.0.1:8080
TRACELITE_CORE_URL=http://127.0.0.1:8080
TRACELITE_PUBLIC_URL=http://localhost:5173
TRACELITE_WEB_HOST=127.0.0.1
TRACELITE_WEB_PORT=5173
TRACELITE_DB=var/tracelite.db
# Set only on first Core startup, otherwise a random password is written privately.
# TRACELITE_ADMIN_NAME=admin
# TRACELITE_ADMIN_PASSWORD=choose-at-least-12-characters
# TRACELITE_WEB_DIR=web/dist
# TRACELITE_OFFLINE_SECONDS=90
# Built-in probe starts with Core. Defaults are next to TRACELITE_DB.
# TRACELITE_PROBE_STATE=/absolute/path/to/local-probe
# TRACELITE_SITES_FILE=/absolute/path/to/sites.json
# Comma-separated absolute directories authorized for Nginx log reads.
# TRACELITE_LOG_ROOTS=/absolute/path/to/nginx-logs
# Opens only when a site has browserOrigin. Nginx and Core share this host.
# TRACELITE_RELAY_ADDR=127.0.0.1:8091
# Optional: Core starts its own loopback Nginx if this upstream is set.
# TRACELITE_NGINX_UPSTREAM=http://127.0.0.1:8888
# TRACELITE_NGINX_PORT=9080
# TRACELITE_NGINX_SITE_ID=local-web
# TRACELITE_NGINX_SITE_NAME=Local website
# Keep 1 unless collecting from an authorized local test site.
# TRACELITE_NGINX_REQUIRE_CONSENT=1
