# make dev reads .env; shell environment wins. No variables are mandatory.
SAILFIN_ADDR=127.0.0.1:8080
SAILFIN_CORE_URL=http://127.0.0.1:8080
SAILFIN_PUBLIC_URL=http://localhost:5173
SAILFIN_WEB_HOST=127.0.0.1
SAILFIN_WEB_PORT=5173
SAILFIN_DB=var/sailfin.db
# Set only on first Core startup, otherwise a random password is written privately.
# SAILFIN_ADMIN_NAME=admin
# SAILFIN_ADMIN_PASSWORD=choose-at-least-12-characters
# SAILFIN_WEB_DIR=web/dist
# SAILFIN_OFFLINE_SECONDS=90
# Built-in probe starts with Core. Defaults are next to SAILFIN_DB.
# SAILFIN_PROBE_STATE=/absolute/path/to/local-probe
# SAILFIN_SITES_FILE=/absolute/path/to/sites.json
# Comma-separated absolute directories authorized for Nginx log reads.
# SAILFIN_LOG_ROOTS=/absolute/path/to/nginx-logs
# Opens only when a site has browserOrigin. Nginx and Core share this host.
# SAILFIN_RELAY_ADDR=127.0.0.1:8091
# Optional: Core starts its own loopback Nginx if this upstream is set.
# SAILFIN_NGINX_UPSTREAM=http://127.0.0.1:8888
# SAILFIN_NGINX_PORT=9080
# SAILFIN_NGINX_SITE_ID=local-web
# SAILFIN_NGINX_SITE_NAME=Local website
# Keep 1 unless collecting from an authorized local test site.
# SAILFIN_NGINX_REQUIRE_CONSENT=1
